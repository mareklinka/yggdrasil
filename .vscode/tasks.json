{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "npm",
            "type": "process",
            "args": [
                "run",
                "build"
            ],
            "problemMatcher": [
                "$tsc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "Start LLM sandbox",
            "type": "shell",
            "command": "podman",
            "args": [
                "compose",
                "up",
                "--build",
                "-d"
            ],
            "options": {
                "cwd": ".opencode/container"
            },
            "problemMatcher": []
        },
        {
            "label": "Claude CLI",
            "type": "shell",
            "command": "podman",
            "args": [
                "exec",
                "-it",
                "-e",
                "COLORTERM=truecolor",
                "-w",
                "/source",
                "yggdrasil-opencode-dev-1",
                "claude"
            ],
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true,
                "close": true
            },
            "problemMatcher": []
        }
    ]
}