{
  "name": "obsidian-yggdrasil",
  "version": "0.1.0",
  "description": "RAG-powered AI assistance for dungeon masters and world-builders in Obsidian",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc -noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "obsidian-yggdrasil",
    "rag",
    "ai",
    "dnd",
    "world-building"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "builtin-modules": "^5.4.0",
    "esbuild": "0.28.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "obsidian": "~1.12.3",
    "prettier": "^3.9.9",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "module": "ESNext",
  "type": "module",
  "dependencies": {
    "@langchain/classic": "^1.0.52",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/openai": "^1.6.2",
    "langchain": "^1.5.16",
    "pako": "^3.0.2",
    "zod": "^4.6.5"
  }
}
