events {}

http {
    upstream opencode {
        server dev:10000;
    }

    server {
        listen 10000;
        server_name _;

        location / {
            proxy_pass http://opencode;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            # WebSocket / SSE support
            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }

    server {
        # only listen on the LLM port if actually provided - handled by the entrypoint script
        ${LLM_LISTEN_DIRECTIVE}

        # Xena simulators
        listen 4843;
        listen 4844;

        server_name _;

        resolver ${NGINX_RESOLVER} valid=30s;

        location / {
            proxy_pass http://${HOST_GATEWAY}:$server_port;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_buffering off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }
    }
}

stream {
    server {
        resolver ${NGINX_RESOLVER} valid=30s;

        # SQL Server containers
        listen 1533;
        listen 1534;

        # MQTT containers
        listen 1883;
        listen 1884;

        proxy_pass ${HOST_GATEWAY}:$server_port;
    }
}